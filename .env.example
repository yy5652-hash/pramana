# Copy to .env (git-ignored).

# Any OpenAI-compatible chat endpoint. The default is Google's Gemini endpoint.
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1
#   Ollama:      LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=

# live   : call the endpoint and cache every reply (default)
# replay : never touch the network; answer only from data/llm_cache (reproduces the
#          knowledge base, the question bank and the evaluation without a key)
PRAMANA_LLM_MODE=live

# Model chains, in order of preference (comma-separated). A request moves down the chain
# when a model is rate-limited or out of quota. The vision chain must accept images.
# PRAMANA_AUTHOR_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash,gemini-3.5-flash-lite
# PRAMANA_TUTOR_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# PRAMANA_VERIFIER_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# PRAMANA_JUDGE_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# PRAMANA_VISION_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# PRAMANA_BULK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# PRAMANA_RPM=12

# Local models (downloaded on first use).
# PRAMANA_EMBED_MODEL=BAAI/bge-small-en-v1.5
# PRAMANA_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# PRAMANA_WHISPER_MODEL=small.en
